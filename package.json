{
  "name": "obix-binding-ssr",
  "version": "0.5.0",
  "description": "Compatibility name: obix-binding-ssr now resolves to obix-core-ssr. Contains no logic of its own — import from obix-core-ssr in new code.",
  "license": "MIT",
  "author": "OBINexus Computing — Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "obix-core-ssr": "0.5.0"
  },
  "keywords": [
    "obix",
    "compat"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-binding-ssr.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-binding-ssr/issues"
  },
  "homepage": "https://github.com/obinexus/obix-binding-ssr#readme",
  "obix": {
    "shimOf": "obix-core-ssr",
    "replaces": "obix-binding-ssr"
  }
}
